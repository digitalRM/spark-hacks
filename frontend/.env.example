# The frontend POSTs to /api/compile; the server-side route launches the Python
# compiler from the spark-hacks repository and keeps model credentials off-client.
AMICUS_SCHEMA=dataform
SPARK_HACKS_ROOT=
PYTHON_BIN=.venv/bin/python
BQL_COMPILE_TIMEOUT_MS=300000

# Set to 1 only for deterministic offline UI development.
BQL_MOCK=0

# Hosted Nemotron Super compiler (server-side only; never NEXT_PUBLIC_*).
SPARK_HOST=172.16.94.53
RELEVANCE_MODEL=nvidia/nemotron-3.5-lightning
BQL_RELEVANCE_ENABLED=1
BQL_RELEVANCE_MAX_TOKENS=48
BQL_RELEVANCE_TIMEOUT_S=3
BQL_RELEVANCE_MAX_RETRIES=1
BQL_REMOTE_BASE_URL=https://integrate.api.nvidia.com/v1
COMPILER_MODEL=nvidia/nemotron-3-super-120b-a12b
FALLBACK_COMPILER_MODEL=nvidia/nemotron-3-super-120b-a12b
LEGAL_ANSWER_MODEL=nvidia/nemotron-3-super-120b-a12b
LEGAL_ANSWER_MAX_TOKENS=4096
LEGAL_ANSWER_TIMEOUT_S=300
LEGAL_ANSWER_MAX_RETRIES=2
LEGAL_ANSWER_TEMPERATURE=0.2
NVIDIA_API_KEY=
BQL_ENABLE_THINKING=1
BQL_REASONING_BUDGET=16384
BQL_MAX_TOKENS=16384
BQL_CONTEXT_TOKENS=32768
BQL_TEMPERATURE=1
BQL_TOP_P=0.95

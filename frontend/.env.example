# The frontend talks to the Python API directly (api/server.py). Start it with
#   .venv/bin/python -m api.server
# Router, compiler, legal-answer and model configuration belong to that process,
# not to this one — see ../.env.example. Nothing secret goes in this file:
# NEXT_PUBLIC_* values are baked into the browser bundle at build time.

NEXT_PUBLIC_AMICUS_API_URL=http://172.16.94.53:8000

# The executor, once it exists. Unset means the results pane uses bundled fixtures.
NEXT_PUBLIC_RUNTIME_URL=

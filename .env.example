# Configuration for the Python API process (api/server.py) and the CLI.
#
# Nothing loads this file automatically -- there is no dotenv in the pipeline. These
# are read from the process environment, so export them or source this file before
# starting the API. They used to live in frontend/.env.local and reach Python through
# the Next route's subprocess; the API is its own process now, so they belong here.

# Which corpus the compiler targets. dataform is the canonical nested entity model
# produced by step 1; courtlistener is the flat physical schema.
AMICUS_SCHEMA=dataform

# API server
AMICUS_HOST=127.0.0.1
AMICUS_PORT=8000
AMICUS_CORS_ORIGINS=http://localhost:3000

# Set to 1 for deterministic offline work: the relevance gate and the compiler both
# return canned answers and nothing touches the network.
BQL_MOCK=0

# Legal request router -- local Nemotron Lightning on Spark :8001, ahead of any
# hosted call. Returns one of three routes: reject, compile, answer. Set
# BQL_RELEVANCE_ENABLED=0 only to bypass it for diagnostics.
SPARK_HOST=172.16.94.53
RELEVANCE_MODEL=nvidia/nemotron-3.5-lightning
BQL_RELEVANCE_ENABLED=1
BQL_RELEVANCE_MAX_TOKENS=48
BQL_RELEVANCE_TIMEOUT_S=3
BQL_RELEVANCE_MAX_RETRIES=1

# The "answer" route: a legal question BQL cannot express, answered directly by
# hosted Super. Never reaches the optimizer or the runtime.
LEGAL_ANSWER_MODEL=nvidia/nemotron-3-super-120b-a12b
LEGAL_ANSWER_MAX_TOKENS=4096
LEGAL_ANSWER_TIMEOUT_S=300
LEGAL_ANSWER_MAX_RETRIES=2
LEGAL_ANSWER_TEMPERATURE=0.2

# Hosted Nemotron Super compiler. Never expose these to the browser.
BQL_REMOTE_BASE_URL=https://integrate.api.nvidia.com/v1
COMPILER_MODEL=nvidia/nemotron-3-super-120b-a12b
FALLBACK_COMPILER_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_API_KEY=
BQL_ENABLE_THINKING=1
BQL_REASONING_BUDGET=16384
BQL_MAX_TOKENS=16384
BQL_CONTEXT_TOKENS=32768
BQL_TEMPERATURE=1
BQL_TOP_P=0.95
BQL_COMPILE_TIMEOUT_MS=300000

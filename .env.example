# Amicus configuration -- copy to .env, which every process reads.
#
#   cp .env.example .env
#   scripts/dev.sh            # API + frontend, both with this environment
#
# Python reads this file through config.py (python-dotenv); scripts/ exports it into
# the API and Next.js processes, which is how AMICUS_API_URL reaches the browser
# bundle. A real exported environment variable always wins over a value here.
#
# Everything Amicus owns is AMICUS_*. Vendor credentials keep their vendor's name.

# --- models -----------------------------------------------------------------
# Every model speaks the OpenAI protocol against one endpoint: one base URL, one key.
NVIDIA_API_KEY=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
AMICUS_BASE_URL=https://integrate.api.nvidia.com/v1

# Hosted Nemotron Super does the routing, the compiling and the direct legal answers.
AMICUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Only set this to put the cheap router on a different (e.g. locally served) model.
AMICUS_ROUTER_MODEL=

# 1 for deterministic offline work: the router and the compiler both return canned
# answers and nothing touches the network.
AMICUS_MOCK=0

# --- corpus -----------------------------------------------------------------
# dataform is the canonical nested entity model produced by step 1; courtlistener is
# the flat physical schema.
AMICUS_SCHEMA=dataform

# --- processes --------------------------------------------------------------
# Where the API binds, and where the browser reaches it. They differ on purpose: the
# API binds every interface, the browser needs a routable address for the box it
# runs on (e.g. http://172.16.94.53:8000 when the API is on the Spark).
AMICUS_HOST=0.0.0.0
AMICUS_PORT=8000
AMICUS_API_URL=http://127.0.0.1:8000

AMICUS_WEB_PORT=3000
# Origins the API accepts browser requests from. Defaults to http://localhost:$AMICUS_WEB_PORT.
AMICUS_CORS_ORIGINS=

# The executor, once it exists. Unset means the results pane uses bundled fixtures.
AMICUS_RUNTIME_URL=

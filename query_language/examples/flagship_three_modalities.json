{
  "bql_version": "2.0",
  "schema": "courtlistener",
  "question": "9th Circuit qualified-immunity cases citing Graham v. Connor, where the scanned record contains a photographic exhibit, and a judge expressed skepticism at oral argument.",
  "query": {

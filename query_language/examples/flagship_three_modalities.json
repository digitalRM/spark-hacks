  "printed": "select cluster.id, cluster.case_name\nfrom (((cluster as cluster join docket as docket on cluster.docket_id = docket.id) join opinion as opinion on opinion.cluster_id = cluster.id) join citation as citation on citation.citing_opinion_id = opinion.id)\nwhere (docket.court_id = \"ca9\" and citation.cited_cite = \"490 U.S. 386\" and fuzzy(opinion.plain_text, \"qualified immunity for excessive force\") and fuzzy(cluster.scan_pages, \"contains a photographic exhibit\") and fuzzy(docket.argument, \"a judge expressed skepticism\"))\nlimit 10"
